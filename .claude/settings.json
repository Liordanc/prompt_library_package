{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; [[ \"$f\" == *.gs ]] && clasp push || true; }",
            "statusMessage": "מעדכן GAS...",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
